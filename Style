* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background-color: #f4f4f4;
}

/* HEADER */

header {
    background: #222;
    color: white;
    padding: 15px 30px;
}

nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.links a {
    color: white;
    text-decoration: none;
    margin-right: 20px;
}

.links a:hover {
    text-decoration: underline;
}

.logo {
    font-weight: bold;
    font-size: 20px;
}

/* LAYOUT */

.container {
    display: flex;
    padding: 30px;
}

/* SIDEBAR */

.sidebar {
    width: 200px;
    margin-right: 30px;
}

.sidebar ul {
    list-style: none;
}

.sidebar li {
    margin-bottom: 15px;
}

.box {
    height: 50px;
    background: white;
    border: 1px solid #ccc;
    border-radius: 8px;
}

/* CONTENT */

.content {
    flex: 1;
}

.card {
    background: white;
    padding: 20px;
    border-radius: 10px;
    border: 1px solid #ddd;
}

.card-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
}

.card p {
    margin-bottom: 20px;
    color: #555;
}

.actions {
    text-align: right;
}

.actions button {
    padding: 8px 12px;
    margin-left: 10px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-size: 16px;
}

.actions button:hover {
    opacity: 0.8;
}
